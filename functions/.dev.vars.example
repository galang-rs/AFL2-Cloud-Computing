# Cloudflare Workers local environment variables template
# Copy this file to .dev.vars (which is ignored by git) and fill in your actual credentials.

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_API_KEY=your_firebase_web_api_key_here
JWT_SECRET=your_super_secret_jwt_key_here
