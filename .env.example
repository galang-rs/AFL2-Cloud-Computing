# Root environment variables template
# Copy to .env for local orchestration scripts or development.

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_API_KEY=your_firebase_web_api_key_here
JWT_SECRET=your_super_secret_jwt_key_here
VITE_API_BASE_URL=https://your-worker-api.your-subdomain.workers.dev
HOSTING_URL=https://your_project_id.web.app
