# Frontend environment variables template
# Copy this file to .env or .env.local and fill in your actual values.

# Cloudflare Worker or Backend API Base URL
VITE_API_BASE_URL=https://your-worker-api.your-subdomain.workers.dev

# Firebase Configuration (for optional fallback or analytics)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
